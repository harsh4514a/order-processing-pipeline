{
  "info": {
    "name": "Order App API",
    "description": "Backend Engineering Assessment API collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Upload Orders",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": ""
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/upload-orders",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "upload-orders"]
        }
      }
    },
    {
      "name": "Get Order By ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "orders", "{{orderId}}"]
        }
      }
    },
    {
      "name": "Get Orders By Customer",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/orders?customerId={{customerId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "orders"],
          "query": [
            {
              "key": "customerId",
              "value": "{{customerId}}"
            }
          ]
        }
      }
    },
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "health"]
        }
      }
    },
    {
      "name": "Metrics",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/metrics",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "metrics"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "orderId",
      "value": "order-1"
    },
    {
      "key": "customerId",
      "value": "customer-1"
    }
  ]
}
